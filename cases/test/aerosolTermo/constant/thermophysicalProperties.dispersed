FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.dispersed;
}

thermoType
{
    type            heAerosolRhoThermo;
    mixture         aerosolPhase;
    transport       const;
    thermo          hConst;
    energy          sensibleInternalEnergy;
    equationOfState rhoConst;
    specie          specie;
}

species
{
    B
    {
        specie
        {
            molWeight   20;
        }
        equationOfState
        {
            rho         400;
        }
        thermodynamics
        {
            Cp          4000;
            Hf          0;
        }
        transport
        {
            mu          4;
            Pr          1;
        }
        properties
        {
        }
    }
}
