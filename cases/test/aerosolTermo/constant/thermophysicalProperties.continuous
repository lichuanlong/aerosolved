FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.continuous;
}

thermoType
{
    type            heAerosolRhoThermo;
    mixture         aerosolPhase;
    transport       const;
    thermo          eConst;
    energy          sensibleInternalEnergy;
    equationOfState rhoConst;
    specie          specie;
}

componentMixing
{
    viscosity       WilkeWassiljewa;
    conductivity    default;
}

species
{
    A
    {
        specie
        {
            molWeight       10;
        }
        thermodynamics
        {
            Cv          1000;
            Hf          0;
        }
        transport
        {
            mu          1;
            Pr          1;
        }
        equationOfState
        {
            rho             100;
        }
        diffusivities
        {
            A               FullerSchettlerGiddings;
            B               FullerSchettlerGiddings;
        }
        properties
        {
            Vd              constant 10;
        }
    }

    B
    {
        specie
        {
            molWeight       20;
        }
        thermodynamics
        {
            Cv          2000;
            Hf          0;
        }
        transport
        {
            mu          2;
            Pr          1;
        }
        equationOfState
        {
            rho             200;
        }
        diffusivities
        {
            B               FullerSchettlerGiddings;
        }
        properties
        {
            Vd              constant 20;
        }
    }
}
