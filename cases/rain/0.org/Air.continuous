FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Air.continuous;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.999;

boundaryField
{
    bottom
    {
        type        zeroGradient;
    }
   
    top
    {
        type        zeroGradient;
    }

    empties
    {
        type        empty;
    }
}
