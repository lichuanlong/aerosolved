FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1E5;

boundaryField
{
    inlet
    {
        type        fixedFluxPressure;
    }

    outlet
    {
        type        fixedFluxPressure;
    }

    walls
    {
        type        fixedFluxPressure;
    }

    top
    {
        type        fixedFluxPressure;
    }

    empties
    {
        type        empty;
    }
}
