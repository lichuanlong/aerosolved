FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     aerosolEulerFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          1e-6;

writeControl    adjustableRunTime;

writeInterval   0.1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       1E-2;

libs            ("libcustomFunctions.so");

functions
{
    SMF
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");

        regionType      patch;
        operation       average;
        name            inlet;

        writeFields     no;

        fields
        (
            Air.continuous
            Water.continuous
            PG.continuous
            VG.continuous

            Water.dispersed
            PG.dispersed
            VG.dispersed
        );
    }

    S.PG
    {
        type            saturation;
        libs            ("libaerosolModels.so");
        species         PG;
        writeControl    writeTime;
        executeControl  writeTime;
    }

    S.VG
    {
        type            saturation;
        libs            ("libaerosolModels.so");
        species         VG;
        writeControl    writeTime;
        executeControl  writeTime;
    }

    S.Water
    {
        type            saturation;
        libs            ("libaerosolModels.so");
        species         Water;
        writeControl    writeTime;
        executeControl  writeTime;
    }

}
