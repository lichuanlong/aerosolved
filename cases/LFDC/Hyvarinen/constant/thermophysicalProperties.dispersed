            rhoCoeffs<8>
            (
                1029.5
               -0.75
                0
                0
                0
                0
                0
                0
            );
        }
        thermodynamics
        {
            // Not relevant due to phase mixing

            Cp          4000;
            Hf          0;
        }
        transport
        {
            // Not relevant due to phase mixing

            mu          1e-4;
            Pr          1;
        }
        properties
        {
            sigma       polynomial
            (
                ( 48.32e-3  0)
                (-8.181e-5  1)
            );
        }
    }
}
